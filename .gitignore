```gitignore
# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.local
.env.development
.env.production
.env.test

# Keep the example environment file tracked
!.env.example

# Build outputs
dist/
build/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing and coverage
coverage/
.nyc_output/

# Runtime files
pids/
*.pid
*.pid.lock

# Uploads generated locally (uncomment if appropriate)
# uploads/
# public/uploads/

# Temporary files and caches
.tmp/
.temp/
.cache/

# Prisma
# Keep prisma/schema.prisma and migration files tracked
# prisma/schema.prisma
# prisma/migrations/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE
.vscode/
.idea/

# Deployment
.vercel/

# TypeScript
*.tsbuildinfo

# Debug files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
